{
  "name": "cutmetry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared geometry and project foundation for Cutmetry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node tools/serve.mjs",
    "build:pages": "npm run build && node tools/build-pages.mjs",
    "check:pages": "node tools/check-pages.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
